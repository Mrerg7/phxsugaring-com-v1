---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';

const benefits = (await getCollection('benefits')).sort((a, b) => a.data.order - b.data.order);

const iconMap: Record<string, 'hand' | 'check-double' | 'clock' | 'droplet' | 'leaf'> = {
  'fa-hand-paper': 'hand',
  'fa-check-double': 'check-double',
  'fa-clock': 'clock',
  'fa-droplet': 'droplet',
  'fa-water': 'droplet',
  'fa-leaf': 'leaf',
};
---

<section id="sugaring" class="relative z-10 border-y border-[var(--border)]" style="background: var(--bg-elevated);">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 sm:py-16 md:py-20">
    <div class="text-center mb-12 fade-up">
      <div class="modern-pill inline-block mb-3">ANCIENT METHOD · MODERN APPEAL</div>
      <h2 class="section-header tracking-tight">The natural, gentle alternative to traditional waxing</h2>
    </div>

    <div class="max-w-3xl mx-auto text-[var(--fg-muted)] fade-up">
      <p class="text-lg leading-relaxed">
        Sugaring (also known as sugar waxing or Persian waxing) is an ancient, natural hair removal method that uses a paste made primarily of sugar, lemon juice, and water. Historically used since 1900 BC in regions surrounding Persia and Egypt, it is applied at room or body temperature — eliminating the risk of burns associated with hot wax.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6 mt-12">
      {benefits.map((benefit) => (
        <div class="clean-section rounded-2xl sm:rounded-3xl p-6 sm:p-8 fade-up">
          <h3 class="font-semibold text-lg mb-4 flex items-center gap-x-3 text-[var(--fg)]">
            <span class="benefit-icon">
              <Icon name={iconMap[benefit.data.icon] || 'droplet'} size={18} />
            </span>
            <span>{benefit.data.title}</span>
          </h3>
          <p class="text-[var(--fg-muted)]">{benefit.data.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
