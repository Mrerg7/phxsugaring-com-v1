---
import { ACQUISITION_MAILTO, SITE, DISCLAIMER_DATE } from '../config/site';
import Icon from './Icon.astro';

const footerLinks = [
  { href: '/#why', label: 'Why This Domain' },
  { href: '/#sugaring', label: 'About Sugaring' },
  { href: '/#use-cases', label: 'Use Cases' },
  { href: '/guides/', label: 'Guides' },
  { href: '/guides/domain-valuation/', label: 'Domain Valuation' },
  { href: '/guides/phoenix-sugaring-market/', label: 'Market Trends' },
  { href: '/#acquire', label: 'Acquire' },
];
---

<footer class="relative z-10 border-t border-[var(--border)]" style="background: var(--bg-elevated);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <div
      class="relative overflow-hidden rounded-2xl sm:rounded-3xl border border-[var(--accent)]/20 p-6 sm:p-8 md:p-12 mb-10 sm:mb-12 text-white"
      style="background: linear-gradient(135deg, #1f1c19 0%, #2a221c 55%, rgba(154,79,46,0.28) 100%);"
    >
      <div class="relative z-10 grid lg:grid-cols-[1.2fr_0.8fr] gap-10 items-center">
        <div>
          <p class="text-xs uppercase tracking-[3px] text-[#D4A07A] font-extrabold mb-4">Domain Available for Acquisition</p>
          <h2 class="font-display text-2xl sm:text-3xl md:text-4xl tracking-tight mb-4">
            phxsugaring.com — A Premium Phoenix Beauty Asset
          </h2>
          <p class="text-white/70 max-w-xl leading-relaxed">
            Positioned at the intersection of Phoenix local SEO, natural beauty branding, and the growing sugaring niche,
            this domain is a rare strategic asset. Serious buyers may inquire for pricing, transfer logistics, and escrow options.
          </p>
        </div>

        <div class="rounded-2xl p-6 sm:p-8 border border-white/10 bg-black/40 backdrop-blur-xl">
          <p class="text-xs uppercase tracking-[2px] text-white/50 font-semibold mb-2">Acquisition Contact</p>
          <a
            href={`mailto:${SITE.email}`}
            class="block text-xl sm:text-2xl md:text-3xl font-display text-white hover:text-[#D4A07A] transition-colors break-all"
          >
            {SITE.email}
          </a>
          <a
            href={ACQUISITION_MAILTO}
            data-cta="footer_inquire"
            class="mt-6 inline-flex w-full items-center justify-center gap-x-3 px-6 py-4 min-h-[48px] bg-[var(--accent)] text-white font-extrabold rounded-2xl hover:brightness-110 transition-all"
          >
            <span>Inquire About Acquisition</span>
            <Icon name="arrow-right" size={18} />
          </a>
          <p class="mt-4 text-[11px] text-white/40 text-center tracking-wide">
            Confidential inquiries · Response within 24 hours
          </p>
        </div>
      </div>
    </div>

    <nav class="mb-10" aria-label="Footer">
      <ul class="flex flex-wrap gap-x-5 gap-y-3 text-sm">
        {footerLinks.map((link) => (
          <li>
            <a href={link.href} class="text-[var(--fg-muted)] hover:text-[var(--accent)] transition-colors">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <p class="text-xs text-[var(--fg-subtle)] leading-relaxed max-w-4xl mb-10">
      This website markets the domain name {SITE.name} for acquisition. It does not operate a sugaring studio or offer
      clinical services. Statistics and market commentary are informational as of {DISCLAIMER_DATE} and subject to change.
      Transactions may proceed via Escrow.com or equivalent protected transfer.
    </p>

    <div class="pt-8 border-t border-[var(--border)] text-xs text-[var(--fg-subtle)] flex flex-col md:flex-row gap-y-3 items-center justify-between text-center md:text-left">
      <div>&copy; 2026 {SITE.name}. Premium domain available for acquisition.</div>
      <div>Local SEO · Natural beauty positioning · Cloudflare edge delivery</div>
    </div>
  </div>
</footer>
