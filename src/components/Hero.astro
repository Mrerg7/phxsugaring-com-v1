---
import { ACQUISITION_MAILTO, cfImageUrl, CF_IMAGES } from '../config/site';

const heroImage = cfImageUrl(CF_IMAGES.heroImageId);
---

<header class="relative min-h-[90vh] flex items-center justify-center overflow-hidden">
  <div
    class="absolute inset-0 z-0"
    style={`
      background-image: url('${heroImage}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    `}
    aria-hidden="true"
  ></div>
  <div class="absolute inset-0 z-[1] bg-gradient-to-b from-black/40 via-black/20 to-[#F8F1E9]/95" aria-hidden="true"></div>

  <div class="relative z-[2] max-w-5xl mx-auto px-6 pt-20 pb-16 md:pt-24 md:pb-20 text-center">
    <div class="inline-flex items-center gap-x-2 mb-6">
      <div class="modern-pill flex items-center gap-x-2 px-4 py-1 rounded-2xl text-xs font-bold tracking-[1px] bg-white/90">
        <i class="fa-solid fa-leaf fa-xs"></i>
        <span>NATURAL &bull; ANCIENT &bull; GENTLE</span>
      </div>
    </div>

    <h1 class="domain-name tracking-tighter mb-4 text-white drop-shadow-sm">phxsugaring.com</h1>

    <p class="max-w-2xl mx-auto text-2xl md:text-3xl font-semibold tracking-tight text-white/95 mb-5">
      The clean, modern domain for<br class="hidden md:block" /> professional sugaring in Phoenix.
    </p>

    <p class="max-w-md mx-auto text-lg text-white/80 mb-10">
      Own the most direct and searchable name for the natural, ancient hair removal method clients are seeking.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={ACQUISITION_MAILTO}
        class="group inline-flex items-center justify-center gap-x-3 px-9 py-4 bg-[#B85C38] hover:bg-[#A04E30] text-white font-semibold text-lg rounded-3xl transition-all active:scale-[0.985] shadow-lg shadow-[#B85C38]/30"
      >
        <span>Inquire to Acquire</span>
        <i class="fa-solid fa-arrow-right group-hover:translate-x-0.5 transition-transform"></i>
      </a>

      <a
        href="#sugaring"
        class="inline-flex items-center justify-center px-8 py-4 border border-white/40 hover:bg-white/10 text-white font-semibold text-lg rounded-3xl transition-all"
      >
        Learn About Sugaring
      </a>
    </div>
  </div>
</header>
