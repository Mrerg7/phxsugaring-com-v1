---
import { ACQUISITION_MAILTO, cfImageUrl, CF_IMAGES } from '../config/site';

const heroImage = cfImageUrl(CF_IMAGES.heroImageId);
---

<header id="hero" class="hero-parallax relative min-h-[100dvh] flex items-center justify-center overflow-hidden bg-[#EDE4D7]">
  <!-- Parallax background image -->
  <img
    id="hero-parallax-bg"
    src={heroImage}
    alt=""
    class="hero-parallax__bg fixed inset-0 z-0 h-full w-full object-contain md:object-cover object-center pointer-events-none select-none"
    loading="eager"
    fetchpriority="high"
    aria-hidden="true"
  />

  <!-- Gradient overlay -->
  <div
    class="hero-parallax__overlay fixed inset-0 z-[1] bg-gradient-to-b from-black/45 via-black/25 to-[#F8F1E9]/92"
    aria-hidden="true"
  ></div>

  <div class="relative z-[2] w-full max-w-5xl mx-auto px-4 sm:px-6 py-16 sm:py-20 text-center">
    <div class="inline-flex items-center gap-x-2 mb-4 sm:mb-6 max-w-full">
      <div class="modern-pill flex flex-wrap items-center justify-center gap-x-2 px-3 sm:px-4 py-1.5 rounded-2xl text-[10px] sm:text-xs font-bold tracking-[0.5px] sm:tracking-[1px] bg-white/90">
        <i class="fa-solid fa-leaf fa-xs"></i>
        <span>NATURAL &bull; ANCIENT &bull; GENTLE</span>
      </div>
    </div>

    <h1 class="domain-name tracking-tighter mb-3 sm:mb-4 text-white drop-shadow-md px-1">phxsugaring.com</h1>

    <p class="max-w-2xl mx-auto text-lg sm:text-2xl md:text-3xl font-semibold tracking-tight text-white/95 mb-4 sm:mb-5 drop-shadow-sm px-1">
      The clean, modern domain for<br class="hidden sm:block" /> professional sugaring in Phoenix.
    </p>

    <p class="max-w-md mx-auto text-base sm:text-lg text-white/85 mb-8 sm:mb-10 px-1">
      Own the most direct and searchable name for the natural, ancient hair removal method clients are seeking.
    </p>

    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 sm:gap-4 w-full max-w-md sm:max-w-none mx-auto">
      <a
        href={ACQUISITION_MAILTO}
        class="group inline-flex items-center justify-center gap-x-3 w-full sm:w-auto px-6 sm:px-9 py-4 bg-[#B85C38] hover:bg-[#A04E30] text-white font-semibold text-base sm:text-lg rounded-3xl transition-all active:scale-[0.985] shadow-lg shadow-[#B85C38]/30 min-h-[48px]"
      >
        <span>Inquire to Acquire</span>
        <i class="fa-solid fa-arrow-right group-hover:translate-x-0.5 transition-transform"></i>
      </a>

      <a
        href="#sugaring"
        class="inline-flex items-center justify-center w-full sm:w-auto px-6 sm:px-8 py-4 border border-white/40 hover:bg-white/10 text-white font-semibold text-base sm:text-lg rounded-3xl transition-all min-h-[48px]"
      >
        Learn About Sugaring
      </a>
    </div>

    <div class="mt-6 sm:mt-8 flex flex-col sm:flex-row flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs sm:text-sm text-white/80">
      <div class="flex items-center gap-x-1.5">
        <i class="fa-solid fa-check text-[#B85C38]"></i>
        <span>Local SEO keywords</span>
      </div>
      <div class="flex items-center gap-x-1.5">
        <i class="fa-solid fa-check text-[#B85C38]"></i>
        <span>Natural beauty niche</span>
      </div>
      <div class="flex items-center gap-x-1.5">
        <i class="fa-solid fa-check text-[#B85C38]"></i>
        <span>Premium .com asset</span>
      </div>
    </div>

    <div class="mt-8 sm:mt-12 animate-bounce hidden sm:block">
      <a href="#why" class="inline-flex flex-col items-center gap-y-2 text-white/60 hover:text-white transition-colors">
        <span class="text-xs uppercase tracking-[3px] font-semibold">Scroll</span>
        <i class="fa-solid fa-chevron-down"></i>
      </a>
    </div>
  </div>

  <div
    class="fixed bottom-0 left-1/2 -translate-x-1/2 w-[min(800px,90vw)] h-px bg-gradient-to-r from-transparent via-white/25 to-transparent z-[2] pointer-events-none"
    aria-hidden="true"
  ></div>
</header>

<script>
  function initHeroParallax() {
    const hero = document.getElementById('hero');
    const bg = document.getElementById('hero-parallax-bg');
    if (!hero || !bg) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isMobile = window.matchMedia('(max-width: 767px)').matches;
    if (prefersReducedMotion || isMobile) {
      bg.style.transform = '';
      return;
    }

    const scale = 1.08;
    let ticking = false;

    function updateParallax() {
      const scrollY = window.scrollY;
      const heroHeight = hero.offsetHeight;

      if (scrollY <= heroHeight) {
        bg.style.transform = `translate3d(0, ${scrollY * 0.45}px, 0) scale(${scale})`;
      }

      ticking = false;
    }

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(updateParallax);
          ticking = true;
        }
      },
      { passive: true }
    );

    updateParallax();
  }

  initHeroParallax();
  document.addEventListener('astro:page-load', initHeroParallax);
</script>
