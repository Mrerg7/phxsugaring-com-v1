---
import {
  ACQUISITION_MAILTO,
  OFFER_MAILTO,
  BUY_NOW_MAILTO,
  AGENT_MAILTO,
  SITE,
  cfImageUrl,
  CF_IMAGES,
} from '../config/site';
import Icon from './Icon.astro';

const heroImage = cfImageUrl(CF_IMAGES.heroImageId);
---

<header
  id="hero"
  class="hero-parallax relative min-h-[100dvh] flex items-center justify-center overflow-hidden"
  style="background: var(--bg-muted);"
>
  <img
    id="hero-parallax-bg"
    src={`${heroImage}?width=1920&quality=75&format=auto`}
    srcset={`${heroImage}?width=768&quality=70&format=auto 768w, ${heroImage}?width=1280&quality=72&format=auto 1280w, ${heroImage}?width=1920&quality=75&format=auto 1920w`}
    sizes="100vw"
    alt=""
    class="hero-parallax__bg fixed inset-0 z-0 h-full w-full object-cover object-center pointer-events-none select-none"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    width="1920"
    height="1080"
    aria-hidden="true"
  />

  <div
    class="hero-parallax__overlay fixed inset-0 z-[1] pointer-events-none"
    style="background: linear-gradient(to bottom, var(--hero-overlay-top), var(--hero-overlay-mid), var(--hero-overlay-bottom));"
    aria-hidden="true"
  ></div>

  <div class="relative z-[2] w-full max-w-5xl mx-auto px-4 sm:px-6 py-20 sm:py-24 text-center">
    <p class="font-display text-white/95 text-sm sm:text-base tracking-[0.18em] uppercase mb-5 drop-shadow-sm fade-up is-visible">
      {SITE.name}
    </p>

    <div class="inline-flex items-center gap-x-2 mb-5 sm:mb-6 max-w-full fade-up is-visible" style="transition-delay: 80ms;">
      <div class="modern-pill flex flex-wrap items-center justify-center gap-x-2 px-3 sm:px-4 py-1.5 bg-white/90 text-[10px] sm:text-xs font-bold tracking-[0.5px]">
        <Icon name="leaf" size={12} class="text-[var(--accent)]" />
        <span>PREMIUM DOMAIN FOR SALE</span>
      </div>
    </div>

    <h1 class="domain-name tracking-tighter mb-4 sm:mb-5 text-white drop-shadow-md px-1 fade-up is-visible" style="transition-delay: 120ms;">
      phxsugaring.com
    </h1>

    <p class="max-w-2xl mx-auto text-lg sm:text-2xl md:text-[1.7rem] font-semibold tracking-tight text-white/95 mb-3 sm:mb-4 drop-shadow-sm px-1 fade-up is-visible" style="transition-delay: 180ms;">
      The clean, modern domain for professional sugaring in Phoenix.
    </p>

    <p class="max-w-lg mx-auto text-base sm:text-lg text-white/85 mb-6 px-1 fade-up is-visible" style="transition-delay: 220ms;">
      Available now — strong local SEO, natural beauty niche, escrow-ready transfer.
    </p>

    <!-- Above-the-fold price + CTA cluster -->
    <div
      class="mx-auto mb-7 sm:mb-8 max-w-md rounded-2xl border border-white/25 bg-black/30 backdrop-blur-md px-5 py-4 text-white fade-up is-visible"
      style="transition-delay: 260ms;"
    >
      <div class="flex items-center justify-between gap-3 flex-wrap">
        <div class="text-left">
          <p class="text-[11px] uppercase tracking-[0.16em] text-white/60 font-semibold">Asking</p>
          <p class="text-2xl font-display font-bold leading-tight">{SITE.priceDisplay}</p>
          <p class="text-xs text-white/70 mt-0.5">{SITE.priceHint}</p>
        </div>
        <div class="text-right text-xs text-white/75 space-y-1">
          <p class="inline-flex items-center gap-1.5 justify-end"><Icon name="shield" size={14} /> Escrow.com ready</p>
          <p class="inline-flex items-center gap-1.5 justify-end"><Icon name="lock" size={14} /> HTTPS secured</p>
        </div>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 w-full max-w-xl mx-auto fade-up is-visible" style="transition-delay: 300ms;">
      <a href={BUY_NOW_MAILTO} data-cta="hero_buy_now" class="btn-primary w-full sm:w-auto shadow-lg">
        <span>Buy Now</span>
        <Icon name="arrow-right" size={18} class="transition-transform group-hover:translate-x-0.5" />
      </a>
      <a href={OFFER_MAILTO} data-cta="hero_make_offer" class="btn-secondary w-full sm:w-auto border-white/40 text-white hover:bg-white/10">
        Make Offer
      </a>
      <a href={AGENT_MAILTO} data-cta="hero_contact_agent" class="btn-secondary w-full sm:w-auto border-white/40 text-white hover:bg-white/10">
        Contact Agent
      </a>
    </div>

    <div class="mt-6 sm:mt-8 flex flex-col sm:flex-row flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs sm:text-sm text-white/85 fade-up is-visible" style="transition-delay: 340ms;">
      <div class="flex items-center gap-x-1.5">
        <Icon name="check" size={14} class="text-[#E8B89A]" />
        <span>Local SEO keywords</span>
      </div>
      <div class="flex items-center gap-x-1.5">
        <Icon name="check" size={14} class="text-[#E8B89A]" />
        <span>Natural beauty niche</span>
      </div>
      <div class="flex items-center gap-x-1.5">
        <Icon name="check" size={14} class="text-[#E8B89A]" />
        <span>Premium .com asset</span>
      </div>
    </div>

    <p class="mt-5 text-xs text-white/70" id="viewer-note" aria-live="polite"></p>

    <div class="mt-8 sm:mt-10 animate-bounce hidden sm:block">
      <a href="#why" class="inline-flex flex-col items-center gap-y-2 text-white/60 hover:text-white transition-colors">
        <span class="text-xs uppercase tracking-[3px] font-semibold">Scroll</span>
        <Icon name="chevron-down" size={18} />
      </a>
    </div>
  </div>
</header>

<script>
  function initHeroParallax() {
    const hero = document.getElementById('hero');
    const bg = document.getElementById('hero-parallax-bg');
    if (!hero || !bg) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isMobile = window.matchMedia('(max-width: 767px)').matches;
    if (prefersReducedMotion || isMobile) {
      bg.style.transform = '';
      return;
    }

    const scale = 1.08;
    let ticking = false;

    function updateParallax() {
      const scrollY = window.scrollY;
      const heroHeight = hero.offsetHeight;
      if (scrollY <= heroHeight) {
        bg.style.transform = `translate3d(0, ${scrollY * 0.45}px, 0) scale(${scale})`;
      }
      ticking = false;
    }

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(updateParallax);
          ticking = true;
        }
      },
      { passive: true }
    );
    updateParallax();
  }

  function initViewerNote() {
    const el = document.getElementById('viewer-note');
    if (!el) return;
    try {
      const key = 'ps_views_' + new Date().toISOString().slice(0, 10);
      const n = Number(sessionStorage.getItem(key) || '0') + 1;
      sessionStorage.setItem(key, String(n));
      // Honest exclusivity signal — not a fake multi-user counter
      el.textContent = 'Exclusive one-of-one .com · Serious inquiries only';
    } catch {
      el.textContent = 'Exclusive one-of-one .com · Serious inquiries only';
    }
  }

  initHeroParallax();
  initViewerNote();
  document.addEventListener('astro:page-load', () => {
    initHeroParallax();
    initViewerNote();
  });
</script>
