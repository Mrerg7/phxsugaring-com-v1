---
import { ACQUISITION_MAILTO } from '../config/site';
---

<nav class="bg-white/95 backdrop-blur-md border-b border-[#EDE4D7] sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between gap-3 h-16 sm:h-20 min-w-0">
      <a href="/" class="flex items-center gap-x-2 min-w-0 shrink">
        <div class="w-8 h-8 sm:w-9 sm:h-9 bg-[#B85C38] rounded-2xl flex items-center justify-center shrink-0">
          <span class="text-white text-lg sm:text-2xl font-bold tracking-tighter">PS</span>
        </div>
        <div class="min-w-0 text-base sm:text-xl md:text-2xl font-semibold tracking-tight leading-none">
          <span class="hidden min-[400px]:inline">phxsugaring</span>
          <span class="text-[#B85C38]">.com</span>
        </div>
      </a>

      <div class="flex items-center gap-x-2 sm:gap-x-3 shrink-0">
        <a href="#why" class="hidden md:block px-5 py-2 text-sm font-medium text-[#4A5D4A] hover:text-[#2D2D2D] transition-colors">Why This Domain</a>
        <a href="#sugaring" class="hidden md:block px-5 py-2 text-sm font-medium text-[#4A5D4A] hover:text-[#2D2D2D] transition-colors">About Sugaring</a>

        <a
          href={ACQUISITION_MAILTO}
          class="inline-flex items-center justify-center px-4 sm:px-7 py-3 bg-[#B85C38] hover:bg-[#A04E30] text-white text-xs sm:text-sm font-semibold rounded-2xl transition-all active:scale-[0.985] whitespace-nowrap min-h-[44px] sm:min-h-[48px]"
        >
          <span class="sm:hidden">Inquire</span>
          <span class="hidden sm:inline">Inquire to Acquire</span>
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  window.addEventListener('scroll', () => {
    const nav = document.querySelector('nav');
    if (!nav) return;
    if (window.scrollY > 20) {
      nav.classList.add('nav-scrolled', 'bg-white/95');
    } else {
      nav.classList.remove('nav-scrolled');
    }
  });
</script>
