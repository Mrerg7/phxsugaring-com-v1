---
import { getCollection } from 'astro:content';

const whyPoints = (await getCollection('whyPoints')).sort((a, b) => a.data.order - b.data.order);
---

<section id="why" class="max-w-6xl mx-auto px-6 pb-16">
  <div class="text-center mb-10">
    <div class="modern-pill inline-block mb-3">LOCAL SEO + NICHE POSITIONING</div>
    <h2 class="section-header tracking-tight">Why phxsugaring.com is a strong strategic asset</h2>
  </div>

  <div class="grid md:grid-cols-3 gap-6">
    {whyPoints.map((point) => (
      <div class="value-card clean-section rounded-3xl p-8">
        <div class="w-11 h-11 bg-[#F8F1E9] rounded-2xl flex items-center justify-center mb-6">
          <i class={`fa-solid ${point.data.icon} text-[#B85C38] text-xl`}></i>
        </div>
        <h3 class="font-semibold text-xl tracking-tight mb-3">{point.data.title}</h3>
        <p class="text-[#5C5C5C] leading-relaxed">{point.data.description}</p>
      </div>
    ))}
  </div>
</section>
