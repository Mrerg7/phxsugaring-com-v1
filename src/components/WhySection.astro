---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';

const whyPoints = (await getCollection('whyPoints')).sort((a, b) => a.data.order - b.data.order);

const iconMap: Record<string, 'search' | 'leaf' | 'globe'> = {
  'fa-search': 'search',
  'fa-leaf': 'leaf',
  'fa-globe': 'globe',
};
---

<section id="why" class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 pb-12 sm:pb-16">
  <div class="text-center mb-10 fade-up">
    <div class="modern-pill inline-block mb-3">LOCAL SEO + NICHE POSITIONING</div>
    <h2 class="section-header tracking-tight">Why phxsugaring.com is a strong strategic asset</h2>
    <p class="mt-3 max-w-2xl mx-auto text-[var(--fg-muted)]">
      Built for buyers searching “buy PHX sugaring domain,” “Phoenix sugaring,” and premium local beauty names.
    </p>
  </div>

  <div class="grid md:grid-cols-3 gap-6">
    {whyPoints.map((point) => (
      <div class="value-card clean-section rounded-2xl sm:rounded-3xl p-6 sm:p-8 fade-up">
        <div class="w-11 h-11 bg-[var(--bg-muted)] rounded-2xl flex items-center justify-center mb-6 text-[var(--accent)]">
          <Icon name={iconMap[point.data.icon] || 'search'} size={22} />
        </div>
        <h3 class="font-semibold text-xl tracking-tight mb-3 text-[var(--fg)]">{point.data.title}</h3>
        <p class="text-[var(--fg-muted)] leading-relaxed">{point.data.description}</p>
      </div>
    ))}
  </div>
</section>
